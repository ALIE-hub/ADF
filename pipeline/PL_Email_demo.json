{
	"name": "PL_Email_demo",
	"properties": {
		"activities": [
			{
				"name": "Send_Email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "prepare_email",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-13.centralindia.logic.azure.com:443/workflows/6885c78e3b9a4f209d5f03de2f8b7d31/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=SjHrGUUu6k3dedDil3rQLl3wSXGN1ZkwT-VbjGu9uTA",
					"body": {
						"value": "@variables('logic_apps_body')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare_email",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "prepare email subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare email body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\"email_recepient\":\"@{pipeline().parameters.email_recepient}\", \"subject\":\"@{variables('logic_apps_subject')}\", \r\n\"body\":\"@{variables('logic_apps_body1')}\" }",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare email subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_subject",
					"value": {
						"value": "@{pipeline().parameters.table_name} - @{pipeline().parameters.status}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare email body",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body1",
					"value": {
						"value": "The table @{pipeline().parameters.table_name} ingestion has been completed. the status is @{pipeline().parameters.status}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"table_name": {
				"type": "string"
			},
			"status": {
				"type": "string"
			},
			"email_recepient": {
				"type": "string"
			}
		},
		"variables": {
			"logic_apps_body": {
				"type": "String"
			},
			"logic_apps_subject": {
				"type": "String"
			},
			"logic_apps_body1": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-11-18T06:01:57Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}