{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "demo-adf31"
		},
		"LS_azureSQL_db_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_azureSQL_db'"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://demosink13.dfs.core.windows.net/"
		},
		"LS_azureSQL_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "demo-sql-db-server1.database.windows.net"
		},
		"LS_azureSQL_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "demo_sql_db"
		},
		"LS_azureSQL_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Chaithanya"
		},
		"TGR_EVENT_SIMPLE_properties_PL_FILE_EVENT_parameters_file_name": {
			"type": "string",
			"defaultValue": "@triggerBody().fileName"
		},
		"TGR_EVENT_SIMPLE_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/c0359534-9942-4988-a629-dabc08765957/resourceGroups/Test/providers/Microsoft.Storage/storageAccounts/demosink13"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_DEMO')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Read_cust_table",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_azureSQL_db",
								"type": "DatasetReference",
								"parameters": {
									"schema": "jenf",
									"table_name": "jaefn"
								}
							},
							"firstRowOnly": false
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-11-16T11:17:23Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_azureSQL_db')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_DEMO_INGESTION')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Execute_send_email_pipeline",
						"type": "ExecutePipeline",
						"state": "Inactive",
						"onInactiveMarkAs": "Succeeded",
						"dependsOn": [
							{
								"activity": "CheckSourceCountIfNewRowsCanbeInsertedorNot",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "PL_Email_demo",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"table_name": {
									"value": "@pipeline().parameters.table_name",
									"type": "Expression"
								},
								"status": "SUCCESS",
								"email_recepient": {
									"value": "@pipeline().globalParameters.email_recepient",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "Execute_send_email_pipeline_for_failure",
						"type": "ExecutePipeline",
						"state": "Inactive",
						"onInactiveMarkAs": "Succeeded",
						"dependsOn": [
							{
								"activity": "CheckSourceCountIfNewRowsCanbeInsertedorNot",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "PL_Email_demo",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"table_name": {
									"value": "@pipeline().parameters.table_name",
									"type": "Expression"
								},
								"status": "FAILED",
								"email_recepient": {
									"value": "@pipeline().globalParameters.email_recepient",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "Read_mod_date_from metadata_table",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "select watermark_value from metadata.table_watermarks where table_name = '@{toLower(pipeline().parameters.table_name)}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_azureSQL_db",
								"type": "DatasetReference",
								"parameters": {
									"schema": "dbo",
									"table_name": "customers"
								}
							},
							"firstRowOnly": true
						}
					},
					{
						"name": "CheckSourceCountIfNewRowsCanbeInsertedorNot",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "CountRecordsWhereWatermarkIsGreaterthanDateValueinTable",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@greater(activity('CountRecordsWhereWatermarkIsGreaterthanDateValueinTable').output.firstRow.count,0)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "Ingest_SQL_db_data",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "select * from dbo.@{pipeline().parameters.table_name} where modifieddate>'@{activity('Read_mod_date_from metadata_table').output.firstRow.watermark_value}'",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_azureSQL_db",
											"type": "DatasetReference",
											"parameters": {
												"schema": "dbo",
												"table_name": {
													"value": "@pipeline().parameters.table_name",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_ADLS_CSV_DEMO",
											"type": "DatasetReference",
											"parameters": {
												"table_name": {
													"value": "@pipeline().parameters.table_name",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "Update_metadata_table_watermark",
									"type": "Script",
									"dependsOn": [
										{
											"activity": "Ingest_SQL_db_data",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_azureSQL_db",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "update metadata.table_watermarks \nset watermark_value=SYSUTCDATETIME()\nwhere table_name = '@{pipeline().parameters.table_name}'",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					},
					{
						"name": "CountRecordsWhereWatermarkIsGreaterthanDateValueinTable",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "Read_mod_date_from metadata_table",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "select count(*) as count from dbo.@{pipeline().parameters.table_name} where ModifiedDate>'@{activity('Read_mod_date_from metadata_table').output.firstRow.watermark_value}'\n",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_azureSQL_db",
								"type": "DatasetReference",
								"parameters": {
									"schema": "dbo",
									"table_name": "customers"
								}
							},
							"firstRowOnly": true
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"table_name": {
						"type": "string",
						"defaultValue": "customers"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-11-23T10:37:36Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/PL_Email_demo')]",
				"[concat(variables('factoryId'), '/datasets/DS_azureSQL_db')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_CSV_DEMO')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_azureSQL_db')]"
			]
		},
